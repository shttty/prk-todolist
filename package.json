{
  "name": "prk-todolist",
  "version": "0.0.1",
  "description": "Todo plugin for PRK and the Pi TUI, with session recovery, compaction continuity, and core semantics derived from Hermes Agent.",
  "license": "MIT",
  "author": "shttty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shttty/prk-todolist.git"
  },
  "homepage": "https://github.com/shttty/prk-todolist#readme",
  "bugs": {
    "url": "https://github.com/shttty/prk-todolist/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "hermes-agent",
    "todo",
    "todolist"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "VALIDATION.md",
    "src/**/*.ts"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^24.13.3",
    "tsx": "4.23.3",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
